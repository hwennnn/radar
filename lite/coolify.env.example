# Required. Use Coolify's secret storage; never commit the real URL.
# A Postgres service on Coolify's private network commonly has TLS disabled:
RADAR_LITE_DATABASE_URL=postgres://USER:PASSWORD@POSTGRES_HOST:5432/DATABASE?sslmode=disable
# For a TLS-enabled external database, deliberately use sslmode=require (or
# verify-full with a trusted root certificate) instead.

# Stable across deploys. Changing this creates a separate Radar Lite state.
RADAR_LITE_SCHEMA=radar_lite

# Routine cadence and bounded first-start readiness window.
RADAR_LITE_INTERVAL=15m
RADAR_LITE_CYCLE_TIMEOUT=20m
RADAR_LITE_HEALTH_ADDR=:8080

# Safe deployment default. External Telegram publishing remains impossible.
RADAR_LITE_DELIVERY_MODE=log
RADAR_LITE_RECIPIENT=local-preview
RADAR_LITE_PUBLISHING_ENABLED=false

# Optional autonomous company/source discovery. Store the real key as a secret.
TINYFISH_API_KEY=
RADAR_LITE_DISCOVERY_BATCH=8
RADAR_LITE_DISCOVERY_TIMEOUT=45s
RADAR_LITE_DISCOVERY_RETRY=6h
RADAR_LITE_DISCOVERY_EMPTY_RETRY=1h

# Add these only after the user explicitly authorizes publishing. Merely adding
# credentials is still insufficient unless delivery mode and the exact gate are
# both changed.
# RADAR_LITE_TELEGRAM_BOT_TOKEN=
# RADAR_LITE_TELEGRAM_CHAT_ID=@earlycareerradar
# RADAR_LITE_DELIVERY_MODE=telegram
# RADAR_LITE_PUBLISHING_ENABLED=true
# Expected publisher identity: @radar_swe_jobs_bot
